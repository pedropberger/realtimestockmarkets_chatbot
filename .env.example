# Example environment configuration
# Copy this file to .env and fill in your actual values

# For Groq (Free API with open-source models)
ENDPOINT=https://api.groq.com/openai/v1
DEPLOYMENT_NAME=llama-3.3-70b-versatile
API_KEY=your_groq_api_key_here
# TEMPERATURE=0.7  # Optional: Only use if your model supports it

# For OpenAI
# ENDPOINT=https://api.openai.com/v1
# DEPLOYMENT_NAME=gpt-4
# API_KEY=your_openai_api_key_here
# TEMPERATURE=0.7

# For Azure OpenAI (like GPT-5.2)
# ENDPOINT=https://your-resource.openai.azure.com/openai/v1/
# DEPLOYMENT_NAME=gpt-5.2-chat
# API_KEY=your_azure_openai_key_here
# Note: Don't set TEMPERATURE for Azure GPT-5.2 as it doesn't support custom values
